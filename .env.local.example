# Clé API Groq (gratuit : https://console.groq.com)
GROQ_API_KEY=gsk_...

# Supabase (optionnel — historique des conversations)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# ─── Replicate Media Pipeline ─────────────────────────────────────────────────
# Clé API Replicate pour générer des images et vidéos
# Obtenez votre token sur : https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_...

# Options optionnelles pour generate-images.js (GitHub Actions / CLI)
# MEDIA_DESCRIPTION="Affiche cinématique du projet"   # Description par défaut
# MEDIA_STYLE=cinematic                                # cinematic|photorealistic|documentary|abstract|poster
# MEDIA_COUNT=1                                        # Nombre de médias à générer
